RAG_HOST=127.0.0.1
RAG_PORT=18080
RAG_AUTH_ENABLED=true
RAG_BEARER_TOKEN=dev-local-token

RAG_DATA_DIR=./data
RAG_UPLOAD_DIR=./data/uploads
RAG_MODEL_CACHE_DIR=./models
RAG_SQLITE_PATH=./data/rag.db
RAG_QDRANT_PATH=./data/qdrant

# The default local models are downloaded lazily on first indexing/query.
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_RERANKER_PROVIDER=fastembed
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_ALLOW_MODEL_FALLBACK=true

# OpenAI-compatible generation endpoint. Keep secrets in the environment only.
RAG_GENERATION_PROVIDER=openai_compatible
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=gpt-5.6-sol
RAG_LLM_TIMEOUT_SECONDS=45
RAG_QUERY_REWRITE_ENABLED=true
RAG_DEEP_AGENT_ENABLED=true

RAG_MAX_FILE_BYTES=52428800
RAG_MAX_QUERY_CHARS=4000
RAG_MAX_CONTEXT_MESSAGES=12
RAG_MAX_CONTEXT_CHARS=12000
RAG_DEFAULT_TOP_K=8
RAG_VECTOR_TOP_K=20
RAG_LEXICAL_TOP_K=20
RAG_RERANK_TOP_K=16
RAG_RERANK_MIN_SCORE=0.22
RAG_EVIDENCE_MIN_SCORE=0.38
RAG_TRACE_MODE=redacted
RAG_TRACE_FULL_TTL_SECONDS=86400
RAG_IDEMPOTENCY_TTL_SECONDS=86400

# Optional LangSmith/LangChain callback integration. Local SQLite traces remain canonical.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=local-rag-service
